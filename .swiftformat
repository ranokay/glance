# Xcode 26 ships Swift 6.2; the project builds in language mode 6.0.
--swift-version 6.2
--language-mode 6.0

--indent tab
--indentcase true
--maxwidth 100
--tabwidth 4
--exclude build
--exclude PreviewCore/target
--exclude PreviewCore/build

--disable hoistTry
--enable commonTypos,forWhere,isEmpty,preferContains,preferFirstWhere,preferFlatMap,preferMinOverSorted,redundantSendable
